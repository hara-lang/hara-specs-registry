{:spec/version "0.0.0-alpha"
 :spec/status :draft
 :syntax :edn
 :purpose :native-runtime-boundary

 :naming
 {:type-object "std.native.<Type>"
  :method-var "std.native.<Type>/<method>"
  :global-object "<Type>"
  :global-method "<Type>/<method>"
  :example {:type std.native.Maths
            :method Maths/sin
            :wrapper std.foundation/sin}
  :constructor new
  :predicate instance?
  :interface-prefix false}

 :source-resolution
 {:status :accepted
  :model :builtin-static-object
  :canonical-object "<Type>"
  :canonical-method "<Type>/<method>"
  :runtime-qualified-identity "std.native.<Type>"
  :namespace-dependency false
  :requireable false
  :aliasable false
  :qualified-source-spelling :noncanonical
  :rules
  ["Native type objects are installed in every namespace at startup."
   "The std.native.<Type> name describes runtime identity; it is not a loadable source namespace."
   "Source calls use <Type>/<method> directly."
   "Require entries such as [std.native.Json :as json] are invalid and must be removed."
   "Aliases such as json/read are normalized to Json/read by migration tooling."]}

 :descriptor
 {:kind :native-type
  :callable false
  :constructs-structs false
  :display "#<native-type <qualified-name>>"
  :identity :canonical-per-runtime
  :protocols [IDisplay INamespaced IObjType]
  :metadata {:required true
             :affects-equality false}
  :inventory :inspectable}

 :inventory
 {:status :accepted
  :closed true
  :type-count 30
  :method-count 282
  :source-of-truth :types
  :extra-types :forbidden
  :extra-methods :forbidden}

 :method-conformance
 {:status :accepted
  :platforms [:rust :truffle]
  :invocation :direct-canonical-method
  :fixture "lib/test-fixtures/std/foundation/native_method_conformance.hal"
  :classifications [:implemented :capability-gated]
  :foundation-exposure [:hal-wrapper :foundation-primitive :native-only]
  :raw-rust
  {:scope :startup-descriptors
   :method-parity false
   :reason :source-libraries-and-capability-providers-are-not-bootstrapped}}

 :startup-visibility
 {:status :accepted
  :platforms [:rust :raw-rust :truffle]
  :canonical-object "std.native.<Type>"
  :canonical-method-namespace "std.native.<Type>"
  :global-alias "<Type>"
  :global-aliases
  [Maths Numbers Bits String Bytes Crypto OS Process File Socket Promise Coroutine Stream Arr Obj
   Runtime Env Printer Document Edn Json Host Test Regex UUID Error Result Base Iter Kernel]
  :identity :same-native-type-object
  :identity-example "(= Maths std.native.Maths std.foundation/Maths)"
  :blank-namespaces true
  :installed-with :global-protocol-aliases}

 :translation-conformance
 {:status :accepted
  :implementation "lib/src/code/translate/rules.hal"
  :test "rust/src/lib.rs#code_translate_resolves_required_namespace_aliases"
  :coverage :all-inventory-types
  :input
  {:dependency "[std.native.<Type> :as native]"
   :aliased-call "native/<method>"
   :qualified-call "std.native.<Type>/<method>"}
  :output
  {:dependency :removed
   :aliased-call "<Type>/<method>"
   :qualified-call "<Type>/<method>"}
  :requirements
  [:inventory-is-closed
   :every-type-has-global-object
   :global-object-is-runtime-qualified-object
   :native-dependencies-are-rejected
   :aliased-calls-are-canonicalized
   :qualified-calls-are-canonicalized
   :translation-is-idempotent]}

 :ownership
 {:syntax :runtime-intrinsic
  :protocol-methods :std.protocol
  :portable-functions :hal
  :host-operations :std.native
  :foundation "Ordinary HAL wrappers over protocol or std.native calls."
  :duplicate-protocol-methods false
  :builtin-activation-clause false}

 :document-model
 {:status :accepted
  :type Document
  :representation :ordinary-hara-data
  :canonical-tags
  [:document/fragment :document/annotate :document/pass :document/escaped
   :document/group :document/line :document/break :document/nest :document/align]
  :annotations {:semantic true :text-rendering :transparent}
  :renderers {:text {:status :implemented :option :width}
              :html {:status :deferred}}
  :visitor {:protocol IEncodeVisitor
            :implementation std.foundation.pretty
            :native-callbacks false}
  :public-alias pretty
  :removed-namespaces [std.pretty std.foundation.pretty.engine]}

 :crypto
 {:status :accepted
  :type Crypto
  :input :bytes
  :implicit-string-encoding false
  :digest-output :lowercase-hex
  :hmac-output :lowercase-hex
  :random-bytes {:result :bytes :maximum-size 1048576}
  :secure-equal {:result :boolean :constant-time-for-equal-length-inputs true}
  :keypair-result {:private :bytes :public :bytes}
  :ed25519 {:private :seed-32
            :public :raw-32
            :signature :raw-64}
  :x25519 {:private :raw-32
           :public :raw-32
           :shared-secret :raw-32
           :reject-all-zero-shared-secret true}
  :p256 {:private :unsigned-scalar-32
         :public :sec1-compressed-33
         :signature :ieee-p1363-64
         :signature-hash :sha256
         :signing :deterministic-rfc6979
         :shared-secret :raw-x-coordinate-32}
  :verification {:invalid-signature false
                 :malformed-key :crypto-error}
  :errors {:prefix "crypto/<method>:" :stable true}}


 :file
 {:status :accepted
  :logical-paths
  {:root "/"
   :separator "/"
   :relative-inputs true
   :returns :canonical-absolute
   :normalisation [:duplicate-separators :dot-segments :parent-segments]
   :escape-above-root :file/outside-root
   :host-paths :provider-private}
  :effects
  {:returns :promise
   :argument-errors :synchronous
   :capability-and-filesystem-errors :rejected-promise}
  :entry-shape
  {:path :string
   :name :string
   :type [:file :directory :symlink :other]
   :size [:integer nil]
   :modified-at :unix-epoch-milliseconds
   :extensions {}}
  :no-follow [:stat :entries :walk :copy]
  :sorted-results [:entries :list :walk]
  :write-default {:mode :create :parents? false}
  :mkdir-default {:parents? true :exists-ok? true}
  :delete-default {:missing-ok? false}
  :copy-default {:replace? false :parents? false :preserve-modified? false}
  :move-default {:replace? false :parents? false :atomic? false}
  :temp-file-default {:prefix "tmp" :suffix ""}
  :temp-directory-default {:prefix "tmp"}
  :stable-error-data
  [:error/code :file/operation :file/path :file/target]
  :stable-error-codes
  [:file/not-found :file/already-exists :file/invalid-path
   :file/outside-root :file/denied :file/not-directory :file/is-directory
   :file/directory-not-empty :file/permission-denied :file/unsupported :file/io]}

 :types
 [{:name Maths
   :availability :implemented
   :methods [abs acos acosh asin asinh atan atan2 atanh ceil cos cosh exp
             floor pow sin sinh sqrt tan tanh]
   :method-classification {:hal-wrapper :all}
   :wrapper-source "lib/src/std/foundation.hal"}
  {:name Numbers
   :availability :implemented
   :methods [long double]
   :method-classification {:hal-wrapper :all}
   :wrapper-source "lib/src/std/foundation.hal"}
  {:name Bits
   :availability :implemented
   :methods [and or xor not shift-left shift-right]
   :method-classification {:hal-wrapper :all}
   :wrapper-source "lib/src/std/foundation.hal"}
  {:name Kernel
   :availability :capability-gated
   :methods [session-create session-close session-list session-info session-eval
             session-namespace session-complete resource-register resource-remove
             resource-list filesystem-create filesystem-attach filesystem-detach
             filesystem-info filesystem-close capabilities]
   :method-classification {:native-only :all}}
  {:name String
   :availability :implemented
   :methods [length blank? includes? starts-with? ends-with? char-at slice
             index-of last-index-of join split split-lines repeat replace
             replace-first trim trim-left trim-right upper lower capitalize
             decapitalize pad-left pad-right reverse encode-utf8 decode-utf8
             to-fixed]
   :method-classification {:hal-wrapper :all}
   :wrapper-source "lib/src/std/foundation/string.hal"}
  {:name Bytes
   :availability :implemented
   :methods [new instance? count get set copy slice u8 s8]
   :method-classification
   {:hal-wrapper [count get set copy slice u8 s8]
    :foundation-primitive [new instance?]}
   :wrapper-source "lib/src/std/foundation/bytes.hal"}
  {:name Crypto
   :availability :implemented
   :methods [sha256 sha512 hmac-sha256 hmac-sha512 random-bytes secure-equal?
             ed25519-keypair ed25519-public ed25519-sign ed25519-verify
             x25519-keypair x25519-public x25519-shared
             p256-keypair p256-public p256-sign p256-verify p256-shared]
   :method-classification {:native-only :all}}
  {:name OS
   :availability :implemented
   :methods [platform arch cwd env getenv]
   :method-classification {:native-only :all}}
  {:name Process
   :availability :capability-gated
   :methods [spawn instance? alive? write close-input stdout stderr
             stdout-stream stderr-stream duplex wait kill]
   :method-classification {:native-only :all}
   :streaming
   {:stdout-stream {:returns :stream :items :bytes :pending-limit 1}
    :stderr-stream {:returns :stream :items :bytes :pending-limit 1}
    :duplex {:receive :stdout-stream
             :send :stdin
             :stderr :separate-stream
             :close :close-input}}}
  {:name File
   :availability :capability-gated
   :methods [parent join resolve read write exists? stat entries list walk mkdir delete
             copy move temp-file temp-directory]
   :method-classification {:native-only :all}
   :deprecated [parent join resolve walk]
   :preferred-path-library std.fs.path}
  {:name Socket
   :availability :capability-gated
   :methods [connect listen endpoint events next receive-stream duplex send close]
   :method-classification {:native-only :all}
   :server-streaming
   {:listen {:arguments [host port options callback]
             :returns :socket-server
             :port-zero :ephemeral
             :callback-events [:open :data :close :error]}
    :endpoint {:returns {:host :string :port :integer}}
    :events {:handles [:socket-server :socket]
             :returns :socket-stream
             :delivery :callback-and-stream
             :queue {:max-events 256
                     :max-bytes 1048576
                     :overflow :close-connection}}
    :next {:returns :promise
           :fulfills :socket-event
           :pending-limit 1}
    :receive-stream {:handles [:socket]
                     :returns :stream
                     :items :bytes
                     :pending-limit 1}
    :duplex {:handles [:socket]
             :receive :receive-stream
             :send :socket-send
             :close :socket-close}
    :threading {:host-threads :raw-events-only
                :hal-callbacks :evaluator-thread}}}
  {:name Promise
   :availability :implemented
   :methods [run new from all delay instance?]
   :method-classification
   {:hal-wrapper [run new from all delay]
    :foundation-primitive [instance?]}
   :wrapper-source "lib/src/std/foundation/promise.hal"}
  {:name Coroutine
   :availability :implemented
   :methods [create yield await instance?]
