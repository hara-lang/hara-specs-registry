(ns gw.build.codec
  (:require [gw.build.normalize :as normalize]))

(defn to-edn
  "Returns canonical ordinary HAL/EDN data."
  [build]
  (normalize/normalize-build build))

(defn from-edn
  "Converts canonical EDN data to a canonical build value."
  [data]
  (normalize/normalize-build data))

(defn read-build-string
  "Reads canonical readable HAL/EDN build data without evaluation."
  [source]
  (from-edn (Edn/read source)))

(defn write-build-string
  "Writes deterministic canonical readable HAL/EDN build data."
  [build]
  (Edn/write (to-edn build)))
