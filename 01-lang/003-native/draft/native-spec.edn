{:document/id :hara/native
 :document/type :native-spec
 :document/version "alpha"
 :document/status :draft
 :document/title "Hara native runtime boundary"
 :document/summary
 "Portable guest-visible contract for std.native descriptors and their implementation-provided methods."

 :spec/conforms-to
 {:spec/id :hara/native-metaspec
  :spec/version "alpha"}

 :native/scope
 {:scope/namespace "std.native"
  :scope/namespace-family "std.native.*"
  :scope/includes
  #{:native-type-descriptors :native-method-vars :runtime-profiles
    :capability-checks :portable-argument-shapes :portable-result-shapes
    :managed-sandbox-descriptor}
  :scope/excludes
  #{:general-host-interop :host-class-lookup :reflection :foundation-wrappers
    :implementation-helper-types :implicit-authority}}

 :native/invariants
 [{:requirement/id :native/explicit-boundary
   :requirement/level :must
   :requirement/text
   "Only declared std.native.* descriptors and methods cross the implementation boundary."}
  {:requirement/id :native/no-ambient-authority
   :requirement/level :must
   :requirement/text
   "Loading or aliasing a native namespace grants no file, network, process, host-call, reflection, or compilation authority."}
  {:requirement/id :native/portable-values
   :requirement/level :must
   :requirement/text
   "Native methods accept and return portable Hara values or explicitly declared opaque Hara runtime values."}
  {:requirement/id :native/profile-explicit
   :requirement/level :must
   :requirement/text
   "A method unavailable in a runtime profile is declared unavailable rather than silently omitted or emulated with different semantics."}]

 :native/naming
 {:naming/type-symbol "Type"
  :naming/type-namespace "std.native.Type"
  :naming/type-var "std.native/Type"
  :naming/method-var "std.native.Type/method"
  :naming/foundation-alias
  "Ordinary non-blank namespaces may resolve Type as an alias for std.native.Type."
  :naming/no-host-name-semantics true}

 :native/language-builtins
 {:builtins/status :internal-runtime-accounting
  :builtins/native-type false
  :builtins/namespace false
  :builtins/var false
  :builtins/contract
  "Builtins names evaluator, compiler, definition, namespace, and interop forms; callable fundamentals are exposed by Base or canonical HAL source."
  :builtins/conformance
  "../../001-language/draft/conformance/native.edn"}

 :native/behavioral-conformance
 {:conformance/manifest "../../001-language/draft/conformance/native.edn"
  :conformance/cases "../../001-language/draft/conformance/native-method-cases.edn"
  :conformance/fixture "../../001-language/draft/conformance/fixtures/native_behavioral.hal"
  :conformance/authority :specs-owned
  :conformance/counts :derived
  :conformance/classifications [:portable :capability-specific :inventory-only]
  :conformance/consumers
  [:jvm-interpreter :truffle :rust-evaluator :rust-bytecode :browser-wasm]}

 :native/types
 [{:native/id :std.native/maths
   :native/symbol Maths :native/namespace std.native.Maths
   :native/availability :portable
   :native/methods [abs acos acosh asin asinh atan atan2 atanh ceil cos cosh
                    exp floor pow sin sinh sqrt tan tanh]}
  {:native/id :std.native/num
   :native/symbol Num :native/namespace std.native.Num
   :native/availability :portable :native/methods [long double]}
  {:native/id :std.native/bits
   :native/symbol Bits :native/namespace std.native.Bits
   :native/availability :portable
   :native/methods [and or xor not shift-left shift-right]}
  {:native/id :std.native/kernel
   :native/symbol Kernel :native/namespace std.native.Kernel
   :native/availability :capability-gated :native/capability :kernel
   :native/methods
   [session-create session-close session-list session-info session-eval
    session-namespace session-complete resource-register resource-remove
    resource-list filesystem-create filesystem-attach filesystem-detach
    filesystem-info filesystem-close capabilities]}
  {:native/id :std.native/sandbox
   :native/symbol Sandbox :native/namespace std.native.Sandbox
   :native/availability :capability-gated :native/capability :sandbox
   :native/methods [open eval call cancel status close]}
  {:native/id :std.native/string
   :native/symbol String :native/namespace std.native.String
   :native/availability :portable
   :native/methods
   [length blank? includes? starts-with? ends-with? char-at slice index-of
    last-index-of join split split-lines repeat replace replace-first trim
    trim-left trim-right upper lower capitalize decapitalize pad-left
    pad-right reverse encode-utf8 decode-utf8 to-fixed]}
  {:native/id :std.native/bytes
   :native/symbol Bytes :native/namespace std.native.Bytes
   :native/availability :portable
   :native/methods [new instance? count get set copy slice u8 s8]}
  {:native/id :std.native/file
   :native/symbol File :native/namespace std.native.File
   :native/availability :capability-gated :native/capability :file
   :native/methods
   [parent join resolve read write exists? stat entries list walk mkdir delete
    copy move temp-file temp-directory]}
  {:native/id :std.native/socket
   :native/symbol Socket :native/namespace std.native.Socket
   :native/availability :capability-gated :native/capability :network
   :native/methods [connect listen endpoint events next send close]}
  {:native/id :std.native/promise
   :native/symbol Promise :native/namespace std.native.Promise
   :native/availability :portable
   :native/methods [run new from all delay instance?]}
  {:native/id :std.native/coroutine
   :native/symbol Coroutine :native/namespace std.native.Coroutine
   :native/availability :portable
   :native/methods [create yield await instance?]}
  {:native/id :std.native/arr
   :native/symbol Arr :native/namespace std.native.Arr
   :native/availability :portable
   :native/methods [new instance? get set push-first push-last pop-first pop-last
                    insert remove clone slice map filter fold-left fold-right]}
  {:native/id :std.native/obj
   :native/symbol Obj :native/namespace std.native.Obj
   :native/availability :portable
   :native/methods [new instance? get set has? delete clone assign keys vals pairs]}
  {:native/id :std.native/runtime
   :native/symbol Runtime :native/namespace std.native.Runtime
   :native/availability :portable
   :native/methods [load-string macroexpand-1 gensym var-sym]}
  {:native/id :std.native/printer
   :native/symbol Printer :native/namespace std.native.Printer
   :native/availability :portable :native/methods [p println]}
  {:native/id :std.native/edn
   :native/symbol Edn :native/namespace std.native.Edn
   :native/availability :portable :native/methods [read]}
  {:native/id :std.native/json
   :native/symbol Json :native/namespace std.native.Json
   :native/availability :portable :native/methods [read write pretty]}
  {:native/id :std.native/host
   :native/symbol Host :native/namespace std.native.Host
   :native/availability :capability-gated :native/capability :host-call
   :native/methods [call describe capabilities capability?]}
  {:native/id :std.native/regexp
   :native/symbol RegExp :native/namespace std.native.RegExp
   :native/availability :portable :native/methods [instance?]}
  {:native/id :std.native/uuid
   :native/symbol UUID :native/namespace std.native.UUID
   :native/availability :portable :native/methods [instance?]}
  {:native/id :std.native/error
   :native/symbol Error :native/namespace std.native.Error
   :native/availability :portable :native/methods [new message class]}
  {:native/id :std.native/base
   :native/symbol Base :native/namespace std.native.Base
   :native/availability :portable
   :native/methods
   [list vector vec set tuple hash-map hash-set atom pointer symbol keyword
    reduced apply not boolean compare reduced? nil? boolean? string? char?
    number? long? double? keyword? symbol? pointer? atom? function?
    bytes? array? object? list? cons? vector? tuple? map? set? sequential? coll?
    satisfies? type instance?]}
  {:native/id :std.native/iter
   :native/symbol Iter :native/namespace std.native.Iter
   :native/availability :portable
   :native/methods
   [iter iter? iter-finite? iter-materialize iter-has? iter-next iter-close
    iter-map iter-filter iter-take-while iter-drop-while iter-mapcat iter-keep
    iter-interpose iter-interleave iter-every? iter-any? iter-take iter-drop
    iter-zip iter-cycle iter-partition-pair iter-partition-all iter-partition
    iter-range iter-constantly iter-repeatedly iter-iterate]}]


 :native/file
 {:file/logical-paths
  {:path/root "/"
   :path/root-meaning :mounted-filesystem-root
   :path/separator "/"
   :path/relative-inputs true
   :path/returned-form :canonical-absolute
   :path/normalisation
   [:collapse-duplicate-separators :remove-dot-segments :resolve-parent-segments]
   :path/outside-root :file/outside-root
   :path/forbidden
   [:tilde-expansion :ambient-working-directory :windows-drive-prefixes
    :host-specific-separators]
   :path/host-mapping :provider-boundary-only}

  :file/effects
  {:effect/result :promise
   :effect/argument-and-type-errors :synchronous
   :effect/capability-and-filesystem-errors :promise-rejection
   :effect/valid-call-never-throws-host-error true}

  :file/operations
  {:pure-compatibility [parent join resolve]
   :metadata [stat entries]
   :read [read exists? list walk]
   :write [write mkdir delete copy move temp-file temp-directory]
   :deprecated [parent join resolve walk]
   :preferred-path-library std.fs.path
   :preferred-directory-enumeration entries}

  :file/options
  {:write {:mode #{:create :replace :append}
           :parents? false
           :default {:mode :create :parents? false}}
   :mkdir {:parents? true
           :exists-ok? true
           :default {:parents? true :exists-ok? true}}
   :delete {:missing-ok? false
            :default {:missing-ok? false}
            :scope #{:file :symlink :empty-directory}}
   :copy {:replace? false
          :parents? false
          :preserve-modified? false
          :scope :one-regular-file
          :follow-links false}
   :move {:replace? false
          :parents? false
          :atomic? false
          :scope :one-provider}
   :temp-file {:prefix "tmp" :suffix ""}
   :temp-directory {:prefix "tmp"}}

  :file/entry
  {:entry/shape
   {:path :canonical-logical-path
    :name :string
    :type #{:file :directory :symlink :other}
    :size #{:integer nil}
    :modified-at :unix-epoch-milliseconds
    :extensions :map}
   :entry/size-only-for :file
   :entry/sorted-by :path
   :entry/follow-symbolic-links false}

  :file/results
  {:read :bytes
   :exists? :boolean
   :stat :entry
   :entries :sorted-entry-vector
   :list :sorted-canonical-path-vector
   :write :canonical-path
   :mkdir :canonical-path
   :delete :canonical-path
   :copy :canonical-target-path
   :move :canonical-target-path
   :temp-file :canonical-path
   :temp-directory :canonical-path}

  :file/errors
  {:error/type ExceptionInfo
   :error/data
   {:error/code :file/code
    :file/operation :keyword
    :file/path :canonical-logical-path
    :file/target #{:canonical-logical-path nil}}
   :error/codes
   [:file/not-found :file/already-exists :file/invalid-path
    :file/outside-root :file/denied :file/not-directory :file/is-directory
    :file/directory-not-empty :file/permission-denied :file/unsupported
    :file/io]
   :error/exists-not-found false
   :error/exists-other-failures :reject
   :error/host-message-non-semantic true}}

 :native/capabilities
 {:capability/catalog
  [{:capability/id :file
    :capability/grants #{:filesystem-read :filesystem-write}}
   {:capability/id :network
    :capability/grants #{:network-connect :network-listen}}
   {:capability/id :kernel
    :capability/grants #{:session-control :resource-control :filesystem-handles}}
   {:capability/id :sandbox
    :capability/grants #{:sandbox-control}}
   {:capability/id :host-call
    :capability/grants #{:embedding-declared-services}}]
  :capability/check-time :method-invocation
  :capability/namespace-load-effect :none
  :capability/denial :native/capability-denied}

 :native/profiles
 {:profile/jvm-truffle
  {:profile/required-types :all
   :profile/host-language :java}
  :profile/rust-native
  {:profile/required-types :all
   :profile/host-language :rust}
  :profile/rust-wasm
  {:profile/required-types :all
   :profile/host-language :rust
   :profile/host-services :embedding-provided}
  :profile/sandbox-restricted
  {:profile/purpose :managed-sandbox-child
   :profile/required-types :portable-pure-subset
   :profile/forbidden-types
   [Kernel Sandbox Package Crypto OS Process File Socket Host]
   :profile/host-services :explicit-narrow-provider-only
   :profile/development-resources false
   :profile/parent-runtime-visible false}
  :profile/parity-rule
  "Portable methods have equal observable results; capability-backed methods may differ only in granted authority and declared host availability."}

