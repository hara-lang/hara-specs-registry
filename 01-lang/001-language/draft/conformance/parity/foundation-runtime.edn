{:spec/version "0.0.0-alpha"
 :language "hara"
 :engines [:truffle :rust-evaluator :rust-bytecode]
 :cases
 [{:id :predicate/native-function
   :source "(function? (fn [value] value))"
   :expect "true"}
  {:id :predicate/callable-keyword
   :source "(fn? :key)"
   :expect "true"}
  {:id :membership/has-map-key
   :source "(has? {:answer 42} :answer)"
   :expect "true"}
  {:id :membership/contains-absent
   :source "(nil? (resolve 'contains?))"
   :expect "true"}
  {:id :numeric/decimal-predicate-absent
   :source "(nil? (resolve 'decimal?))"
   :expect "true"}
  {:id :collection/vec
   :source "(= [1 2 3] (vec '(1 2 3)))"
   :expect "true"}
  {:id :collection/set
   :source "(= #{1 2 3} (set [1 2 3 2]))"
   :expect "true"}
  {:id :collection/reduce-kv
   :source "(= {:a 2 :b 3} (reduce-kv (fn [out key value] (assoc out key (+ value 1))) {} {:a 1 :b 2}))"
   :expect "true"}
  {:id :collection/select-keys
   :source "(= {:b 2} (select-keys {:a 1 :b 2} [:b :missing]))"
   :expect "true"}
  {:id :collection/merge
   :source "(= {:a 1 :b 3} (merge {:a 1 :b 2} {:b 3}))"
   :expect "true"}
  {:id :foundation/string-facade
   :source "(= \"HARA\" (std.foundation.string/upper-case \"hara\"))"
   :expect "true"}
  {:id :native/string-encode-utf8
   :source "(= 3 (count (String/encode-utf8 \"abc\")))"
   :expect "true"}
  {:id :base/canonical-alias
   :source "(= Base std.native.Base)"
   :expect "true"}
  {:id :base/constructors
   :source "(and (= '(1 2) (Base/list 1 2)) (= [1 2] (Base/vector 1 2)) (= #{1 2} (Base/hash-set 1 2)) (= {:answer 42} (Base/hash-map :answer 42)))"
   :expect "true"}
  {:id :base/apply
   :source "(= 42 (Base/apply + [19 23]))"
   :expect "true"}
  {:id :base/truth-and-ordering
   :source "(= [true false true -1 0 1] [(Base/not nil) (Base/not 1) (Base/boolean 1) (Base/compare 1 2) (Base/compare 2 2) (Base/compare 3 2)])"
   :expect "true"}
  {:id :base/predicates
   :source "(and (Base/function? (fn [value] value)) (Base/list? '(1)) (Base/vector? [1]) (Base/map? {:a 1}) (Base/set? #{1}) (Base/sequential? [1]))"
   :expect "true"}]}
