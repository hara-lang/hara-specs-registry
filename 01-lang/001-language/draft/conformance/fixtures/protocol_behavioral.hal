;; Shared behavioral protocol contract owned by hara-specs-registry.
;; Runtime repositories consume this file; they do not own corpus copies.
(ns user)

(defstruct ProtocolUseCase [state])
;; Failure receivers are corpus data. Runtime harnesses execute each quoted
;; call as written and never search for or substitute a receiver.
(def unsupported ICount)
(def unsupported-protocol ICount)

(defn use-case []
  (ProtocolUseCase
    (atom {:collection {:a 1 :b 2}
           :sequence [1 2 3]
           :cell (atom 10)
           :closed false
           :component-status :stopped
           :contexts {}
           :deps {:a {:entry :A :deps #{:b}} :b {:entry :B :deps #{}}}
           :runtimes {}
           :hash-cache 0
           :meta {:source :fixture}
           :realized false
           :value 42
           :watches (atom [])})))

(defn state [fixture]
  (deref (:state fixture)))

(defn state-get [fixture key]
  (get (state fixture) key))

(defn state-put [fixture key value]
  (do (std.protocol.ireset/reset
        (:state fixture)
        (assoc (state fixture) key value))
      value))

(defn thrown? [f]
  (try
    (do (f) false)
    (catch Throwable error true)))

(defn result [protocol method success limit failure-form]
  {:protocol protocol
   :method method
   :success success
   :limit limit
   :limit-category :protocol/arity
   :failure (if (nil? failure-form) :not-applicable :host-checked)
   :failure-form failure-form
   :failure-category (if (nil? failure-form) nil :protocol/unsupported-receiver)
   :pass (if success limit false)})

(defn protocol-case [protocol method method-var success unsupported-form]
  (result protocol
          method
          success
          (thrown? (fn [] (method-var)))
          unsupported-form))

(extend-type ProtocolUseCase IApplicable
  (apply-default [fixture] (state-get fixture :value))
  (apply-in [fixture runtime args]
    (runtime (nth args 0) (nth args 1) (nth args 2)))
  (transform-in [fixture runtime args]
    (runtime (nth args 0) (nth args 1)))
  (transform-out [fixture runtime args value]
    (runtime (nth args 0) (nth args 1) value)))

(extend-type ProtocolUseCase IAssoc
  (assoc [fixture key value] (assoc (state-get fixture :collection) key value)))

(extend-type ProtocolUseCase ICas
  (cas [fixture old-value new-value]
    (std.protocol.icas/cas (state-get fixture :cell) old-value new-value)))

(extend-type ProtocolUseCase IClose
  (close [fixture] (do (state-put fixture :closed true) nil)))

(extend-type ProtocolUseCase IColl
  (start-string [fixture] "(")
  (end-string [fixture] ")")
  (sep-string [fixture] " "))

(extend-type ProtocolUseCase IComponent
  (props [fixture] {:name :component})
  (status [fixture] (state-get fixture :component-status))
  (started? [fixture] (= :started (state-get fixture :component-status)))
  (stopped? [fixture] (= :stopped (state-get fixture :component-status)))
  (start [fixture] (do (state-put fixture :component-status :started) fixture))
  (stop [fixture] (do (state-put fixture :component-status :stopped) fixture))
  (kill [fixture] (do (state-put fixture :component-status :killed) fixture))
  (remote? [fixture] false))

(extend-type ProtocolUseCase IConj
  (conj [fixture value] (conj (state-get fixture :sequence) value)))

(extend-type ProtocolUseCase ICons
  (cons [fixture value] [value 1 2 3]))

(extend-type ProtocolUseCase IContext
  (call [fixture arg] [arg]))

(extend-type ProtocolUseCase ICoroutine
  (status [fixture] (state-get fixture :component-status))
  (resume [fixture arg] [arg]))

(extend-type ProtocolUseCase IStream
  (next [fixture] (state-get fixture :value)))

(extend-type ProtocolUseCase IContextLifeCycle
  (has-module? [fixture module] (not (nil? (get (state-get fixture :contexts) module))))
  (setup-module [fixture module]
    (do (state-put fixture :contexts (assoc (state-get fixture :contexts) module :module))
        fixture))
  (teardown-module [fixture module]
    (do (state-put fixture :contexts (dissoc (state-get fixture :contexts) module))
        fixture))
  (has-pointer? [fixture pointer] (not (nil? (get (state-get fixture :contexts) pointer))))
  (setup-pointer [fixture pointer]
    (do (state-put fixture :contexts (assoc (state-get fixture :contexts) pointer :pointer))
        fixture))
  (teardown-pointer [fixture pointer]
    (do (state-put fixture :contexts (dissoc (state-get fixture :contexts) pointer))
        fixture)))

(extend-type ProtocolUseCase ICount
  (count [fixture] (count (state-get fixture :sequence))))

(extend-type ProtocolUseCase IDeps
  (dep-get [fixture id] (:entry (get (state-get fixture :deps) id)))
  (dep-entries [fixture id] (:deps (get (state-get fixture :deps) id)))
  (dep-keys [fixture] (keys (state-get fixture :deps))))

(extend-type ProtocolUseCase IDeref
  (deref [fixture] (deref (state-get fixture :cell))))

(extend-type ProtocolUseCase IDerefTimeout
  (deref-timeout [fixture milliseconds timeout-value]
    (if (neg? milliseconds) timeout-value (state-get fixture :value))))

(extend-type ProtocolUseCase IDisplay
  (display [fixture] "<protocol-use-case>"))

(extend-type ProtocolUseCase IDissoc
  (dissoc [fixture key] (dissoc (state-get fixture :collection) key)))

(extend-type ProtocolUseCase IEmpty
  (empty [fixture] []))

(extend-type ProtocolUseCase IEncodable
  (encode-with [fixture visitor] :encoded-with))

(extend-type ProtocolUseCase IEncode
  (encode [fixture options] :encoded))

(extend-type ProtocolUseCase IEncodeVisitor
  (visit-nil [fixture] :nil)
  (visit-boolean [fixture value] value)
  (visit-number [fixture value] value)
  (visit-character [fixture value] value)
  (visit-string [fixture value] value)
  (visit-keyword [fixture value] value)
  (visit-symbol [fixture value] value)
  (visit-seq [fixture value] value)
  (visit-vector [fixture value] value)
  (visit-map [fixture value] value)
  (visit-set [fixture value] value)
  (visit-tagged [fixture tag value] [tag value])
  (visit-unknown [fixture value] value))

(extend-type ProtocolUseCase IEquality
  (equality [fixture other] (= (state-get fixture :value) other)))

(extend-type ProtocolUseCase IExInfo
  (data [fixture] {:kind :fixture-error}))

(extend-type ProtocolUseCase IFind
  (find [fixture key]
    (std.protocol.ifind/find (state-get fixture :collection) key)))

(extend-type ProtocolUseCase IFn
  (invoke [fixture arg] [arg]))

(extend-type ProtocolUseCase IHash
  (hash [fixture] (state-get fixture :value)))

(extend-type ProtocolUseCase IHashCached
  (hash-current [fixture] (state-get fixture :hash-cache))
  (hash-put [fixture value] (do (state-put fixture :hash-cache value) fixture)))

(extend-type ProtocolUseCase IIndexed
  (index-of [fixture value]
    (if (= value 1) 0 (if (= value 2) 1 (if (= value 3) 2 nil)))))

(extend-type ProtocolUseCase IIndexedKV
  (index-of-key [fixture key] (if (= key :a) 0 (if (= key :b) 1 -1)))
  (index-of-val [fixture value] (if (= value 1) 0 (if (= value 2) 1 -1))))

(extend-type ProtocolUseCase IInvokeIn
  (invoke-in [fixture context arg]
    (std.protocol.icontext/call context arg)))

(extend-type ProtocolUseCase IIter
  (iter [fixture] (std.protocol.iiter/iter (state-get fixture :sequence))))

(extend-type ProtocolUseCase IIterator
  (iter-next? [fixture]
    (std.protocol.iiterator/iter-next? (state-get fixture :iterator)))
  (iter-next [fixture]
    (std.protocol.iiterator/iter-next (state-get fixture :iterator))))

(extend-type ProtocolUseCase ILookup
  (lookup [fixture key]
    (get (state-get fixture :collection) key)))

(extend-type ProtocolUseCase IMetadata
  (metatype [fixture] :object))

(extend-type ProtocolUseCase INamespaced
  (name [fixture] "demo")
  (namespace [fixture] "std.protocol"))

(extend-type ProtocolUseCase INth
  (nth [fixture index] (nth (state-get fixture :sequence) index)))

(extend-type ProtocolUseCase IObjType
  (meta [fixture] (state-get fixture :meta))
  (with-meta [fixture metadata] (do (state-put fixture :meta metadata) fixture)))

(extend-type ProtocolUseCase IPair
  (key [fixture] :a)
  (value [fixture] 1))

(extend-type ProtocolUseCase IPeekFirst
  (peek-first [fixture] (first (state-get fixture :sequence))))

(extend-type ProtocolUseCase IPeekLast
  (peek-last [fixture] (nth (state-get fixture :sequence) 2)))

(extend-type ProtocolUseCase IPromise
  (state [fixture] :fulfilled)
  (value [fixture] (state-get fixture :value))
  (then [fixture function] (function (state-get fixture :value)))
  (catch [fixture function] fixture)
  (finally [fixture function] (do (function) fixture))
  (cancel [fixture] (do (state-put fixture :component-status :cancelled) fixture)))

(extend-type ProtocolUseCase IPointer
  (ptr-context [fixture] :runtime/demo))

(extend-type ProtocolUseCase IPopFirst
  (pop-first [fixture] [2 3]))

(extend-type ProtocolUseCase IPopLast
  (pop-last [fixture] [1 2]))

(extend-type ProtocolUseCase IPushFirst
  (push-first [fixture value] [value 1 2 3]))

(extend-type ProtocolUseCase IPushLast
  (push-last [fixture value] (conj (state-get fixture :sequence) value)))

(extend-type ProtocolUseCase IRealize
  (realized? [fixture] (state-get fixture :realized))
  (realize [fixture] (do (state-put fixture :realized true) (state-get fixture :value))))

;; IReduce is exercised against a native vector below because Rust currently
;; requires guest variadic implementations to use a fixed compatibility form.

(extend-type ProtocolUseCase IReset
  (reset [fixture value]
    (std.protocol.ireset/reset (state-get fixture :cell) value)))

(extend-type ProtocolUseCase ISpace
  (context-set [fixture context key options]
    (do (state-put fixture :contexts
                   (assoc (state-get fixture :contexts)
                          context
                          {:key key :options options}))
        fixture))
  (context-unset [fixture context]
    (do (state-put fixture :contexts (dissoc (state-get fixture :contexts) context))
        fixture))
  (context-list [fixture] (keys (state-get fixture :contexts)))
  (context-get [fixture context] (get (state-get fixture :contexts) context))
  (rt-active [fixture] (keys (state-get fixture :runtimes)))
  (rt-get [fixture context] (get (state-get fixture :runtimes) context))
  (rt-start [fixture context]
    (do (state-put fixture :runtimes
                   (assoc (state-get fixture :runtimes) context :started))
        :started))
  (rt-started? [fixture context]
    (= :started (get (state-get fixture :runtimes) context)))
  (rt-stopped? [fixture context]
    (not (= :started (get (state-get fixture :runtimes) context))))
  (rt-stop [fixture context]
    (do (state-put fixture :runtimes
                   (assoc (state-get fixture :runtimes) context :stopped))
        fixture)))

(extend-type ProtocolUseCase IToMutable
  (to-mutable [fixture] (array 1 2 3)))

(extend-type ProtocolUseCase IToPersistent
  (to-persistent [fixture] [1 2 3]))

(extend-type ProtocolUseCase IWatch
  (watch-add [fixture key function]
    (std.protocol.iwatch/watch-add (state-get fixture :cell) key function))
  (watch-remove [fixture key]
    (std.protocol.iwatch/watch-remove (state-get fixture :cell) key))
  (watch-list [fixture]
    (std.protocol.iwatch/watch-list (state-get fixture :cell))))

;; Receiver examples are executable corpus data, not one-off host probes.
;; They preserve representative positive and negative satisfaction matrices
;; for inherited protocols, marker protocols, and universal adapters.
(defn receiver-case [id expected actual]
  {:case id
   :expected expected
   :actual actual
   :pass (= expected actual)})

(defn protocol-receiver-matrix-results []
  (let [persistent (vec [1])
        mutable (std.foundation/to-mutable persistent)
        promise (std.foundation.promise/from 1)
        iterator (iter [1])
        object (with-meta (vec [1]) {:source :matrix})
        cached (vec [1])
        results
        [(receiver-case :inheritance/iterator
           [true true]
           [(satisfies? IIterator iterator)
            (satisfies? IIter iterator)])
         (receiver-case :inheritance/lookup
           [true true]
           [(satisfies? ILookup {:a 1})
            (satisfies? IFind {:a 1})])
         (receiver-case :inheritance/promise
           [true true true]
           [(satisfies? IPromise promise)
            (satisfies? IDeref promise)
            (satisfies? IDerefTimeout promise)])
         (receiver-case :inheritance/object
           [true true true]
           [(satisfies? IObjType object)
            (satisfies? IHash object)
            (satisfies? IDisplay object)])
         (receiver-case :inheritance/hash-cached
           [true true]
           [(satisfies? IHashCached cached)
            (satisfies? IHash cached)])
         (receiver-case :inheritance/persistent
           [true true]
           [(satisfies? IToMutable persistent)
            (satisfies? IPersistent persistent)])
         (receiver-case :inheritance/mutable
           [true true]
           [(satisfies? IToPersistent mutable)
            (satisfies? IMutable mutable)])
         (receiver-case :receiver/hash-cached
           [false true true true true false]
           [(satisfies? IHashCached nil)
            (satisfies? IHashCached (vec [1]))
            (satisfies? IHashCached {:a 1})
            (satisfies? IHashCached #{1})
            (satisfies? IHashCached (list 1))
            (satisfies? IHashCached (atom 1))])
         (receiver-case :receiver/universal-hash-adapter
           [false false]
           [(satisfies? IHashCached "x")
            (satisfies? IHash "x")])
         (receiver-case :marker/iofn
           [true true]
           [(satisfies? IOFn :a)
            (satisfies? IFn :a)])]]
    (do
      (std.protocol.iclose/close iterator)
      (std.foundation/to-persistent mutable)
      results)))

;; Original native collection assertions are retained as individually named
;; corpus cases. Runtime tests invoke this entrypoint instead of carrying a
;; second fixture and a host-owned expected vector.
(defn protocol-native-value-results []
  (let [queue (std.native.Algo/queue 1 2)
        mutable-queue (std.foundation/to-mutable queue)
        vector (Base/vec [1 2])
        mutable-map (std.foundation/to-mutable {:a 1})]
    [(receiver-case :native-value/queue-push-first-satisfaction
       true
       (satisfies? IPushFirst queue))
     (receiver-case :native-value/queue-push-first
       (std.native.Algo/queue 0 1 2)
       (std.protocol.ipushfirst/push-first queue 0))
     (receiver-case :native-value/mutable-queue-push-first-satisfaction
       true
       (satisfies? IPushFirst mutable-queue))
     (receiver-case :native-value/mutable-queue-push-first
       0
       (do
         (std.protocol.ipushfirst/push-first mutable-queue 0)
         (std.protocol.ipeekfirst/peek-first mutable-queue)))
     (receiver-case :native-value/mutable-queue-pop-first-satisfaction
       true
       (satisfies? IPopFirst mutable-queue))
     (receiver-case :native-value/mutable-queue-pop-first
       1
       (do
         (std.protocol.ipopfirst/pop-first mutable-queue)
         (std.protocol.ipeekfirst/peek-first mutable-queue)))
     (receiver-case :native-value/vector-push-first-boundary
       false
       (satisfies? IPushFirst vector))
     (receiver-case :native-value/vector-pop-first-boundary
       false
       (satisfies? IPopFirst vector))
     (receiver-case :native-value/vector-push-last-satisfaction
       true
       (satisfies? IPushLast vector))
     (receiver-case :native-value/vector-pop-last-satisfaction
       true
       (satisfies? IPopLast vector))
     (receiver-case :native-value/mutable-map-find-satisfaction
       true
       (satisfies? IFind mutable-map))
     (receiver-case :native-value/mutable-map-find
       [:a 1]
       (std.protocol.ifind/find mutable-map :a))
     (receiver-case :native-value/iterator-traversal-and-close
       [true 1 2 false nil]
       (let [iterator (std.protocol.iiter/iter [1 2])]
         [(std.protocol.iiterator/iter-next? iterator)
          (std.protocol.iiterator/iter-next iterator)
          (std.protocol.iiterator/iter-next iterator)
          (std.protocol.iiterator/iter-next? iterator)
          (std.protocol.iclose/close iterator)]))
     (receiver-case :native-value/atom-watch-key-order
       [2 [:log 1 2]]
       (let [cell (atom 1) seen (atom nil)]
         (std.protocol.iwatch/watch-add
           cell :log
           (fn [key ref old-value new-value]
             (std.protocol.ireset/reset seen [key old-value new-value])))
         (std.protocol.ireset/reset cell 2)
         [(std.protocol.ideref/deref cell)
          (std.protocol.ideref/deref seen)]))
     (receiver-case :native-value/mutable-find-matrix
       [true true [:a 1] nil true :a true [1 20]]
       (let [map-value (std.foundation/to-mutable {:a 1})
             set-value (std.foundation/to-mutable #{:a})
             vector-value (std.foundation/to-mutable (Base/vec [10 20]))]
         [(satisfies? IFind map-value)
          (satisfies? IFind map-value)
          (std.protocol.ifind/find map-value :a)
          (std.protocol.ifind/find map-value :missing)
          (satisfies? IFind set-value)
          (std.protocol.ifind/find set-value :a)
          (satisfies? IFind vector-value)
          (std.protocol.ifind/find vector-value 1)]))]))

;; Predicate assertions formerly embedded in the Rust host tests are part of
;; the behavioral contract because fn? is specified in terms of IFn
;; satisfaction and callable? must not appear as an undocumented substitute.
(defn protocol-predicate-results []
  (eval
    '(do
       (defprotocol ProtocolPredicateReady
         (protocol-predicate-ready [receiver]))
       (defstruct ProtocolPredicateBox [value])
       (def protocol-predicate-before
         (satisfies? ProtocolPredicateReady (ProtocolPredicateBox 1)))
       (extend-type ProtocolPredicateBox ProtocolPredicateReady
         (protocol-predicate-ready [receiver] (:value receiver)))

       (defstruct ProtocolPredicateInvokable [value])
       (defstruct ProtocolPredicatePlain [value])
       (defmutable ProtocolPredicateMutableInvokable [value])
       (defmutable ProtocolPredicateMutablePlain [value])
       (extend-type ProtocolPredicateInvokable IFn
         (invoke [receiver] (:value receiver)))
       (extend-type ProtocolPredicateMutableInvokable IFn
         (invoke [receiver] (field receiver :value)))

       (let [function (fn [value] value)
             pointer-value (pointer {:context :kernel :id "ROOT"})]
         [(receiver-case :predicate/native-capabilities
            [true true true true true true true true
             true true true true true true true true]
            [(coll? {})
             (satisfies? IIter "value")
             (satisfies? IIterator (iter []))
             (satisfies? ICount nil)
             (satisfies? IReduce [])
             (satisfies? INth [1])
             (satisfies? IAssoc {})
             (satisfies? IFind #{:value})
             (satisfies? ILookup {:value 1})
             (satisfies? IDeref (atom 1))
             (satisfies? IReset (atom 1))
             (satisfies? ICas (atom 1))
             (satisfies? IWatch (atom 1))
             (satisfies? IPair (first {:value 1}))
             (satisfies? IPersistent [])
             (satisfies? IMutable
                         (std.foundation/to-mutable (Base/vec [])))])
          (receiver-case :predicate/extension-registration
            [false true]
            [protocol-predicate-before
             (satisfies? ProtocolPredicateReady (ProtocolPredicateBox 1))])
          (receiver-case :predicate/ifn-versus-function
            [[true true 3] [true true 2] [true false] [true false]
             [true false] [true false 4] [true false]
             [true false true 1] [true false true 2]
             [false false] [false false] [false false]]
            [[(fn? function) (function? function)
              (std.protocol.ifn/invoke function 3)]
             [(fn? inc) (function? inc)
              (std.protocol.ifn/invoke inc 1)]
             [(fn? :key) (function? :key)]
             [(fn? {:key 1}) (function? {:key 1})]
             [(fn? #{:key}) (function? #{:key})]
             [(fn? ProtocolPredicateInvokable)
              (function? ProtocolPredicateInvokable)
              (:value
                (std.protocol.ifn/invoke ProtocolPredicateInvokable 4))]
             [(fn? pointer-value) (function? pointer-value)]
             [(fn? (ProtocolPredicateInvokable 1))
              (function? (ProtocolPredicateInvokable 1))
              (satisfies? IFn
                          (ProtocolPredicateInvokable 1))
              ((ProtocolPredicateInvokable 1))]
             [(fn? (ProtocolPredicateMutableInvokable 2))
              (function? (ProtocolPredicateMutableInvokable 2))
              (satisfies? IFn
                          (ProtocolPredicateMutableInvokable 2))
              ((ProtocolPredicateMutableInvokable 2))]
             [(fn? (ProtocolPredicatePlain 1))
              (satisfies? IFn (ProtocolPredicatePlain 1))]
             [(fn? (ProtocolPredicateMutablePlain 2))
              (satisfies? IFn
                          (ProtocolPredicateMutablePlain 2))]
             [(fn? 42) (function? 42)]])
          (receiver-case :predicate/no-callable-alias
            true
            (nil? (resolve 'callable?)))
          (receiver-case :predicate/no-collection-alias
            true
            (nil? (resolve 'collection?)))
          (receiver-case :predicate/non-ifn-immutable-rejected
            true
            (thrown? (fn [] ((ProtocolPredicatePlain 1)))))
          (receiver-case :predicate/non-ifn-mutable-rejected
            true
            (thrown? (fn [] ((ProtocolPredicateMutablePlain 2)))))]))))

;; Cross-cutting protocol behavior is kept beside the per-method corpus so
;; every runtime executes the same extension, reload, collision, mutability,
;; and normalized-error examples.
(defn protocol-cross-cutting-results []
  (eval
    '(do
       (defstruct ProtocolInheritanceBox [value])
       (extend-type ProtocolInheritanceBox ICoroutine
         (status [receiver] :ready)
         (resume [receiver & values] values))
       (def protocol-inheritance-before
         (satisfies? ICoroutine
                     (ProtocolInheritanceBox 41)))
       (extend-type ProtocolInheritanceBox IClose
         (close [receiver] :closed))
       (def protocol-inheritance-after
         [(satisfies? ICoroutine
                      (ProtocolInheritanceBox 42))
          (std.protocol.icoroutine/status (ProtocolInheritanceBox 43))
          (std.protocol.iclose/close (ProtocolInheritanceBox 44))])

       (defstruct ProtocolImmutableExample [value])
       (defmutable ProtocolMutableExample [value])
       (defprotocol ProtocolReadExample
         (protocol-read-example [receiver]))
       (extend-type ProtocolImmutableExample ProtocolReadExample
         (protocol-read-example [receiver] (:value receiver)))
       (extend-type ProtocolMutableExample ProtocolReadExample
         (protocol-read-example [receiver] (field receiver :value)))
       (def protocol-extension-initial
         [(protocol-read-example (ProtocolImmutableExample 41))
          (protocol-read-example (ProtocolMutableExample 42))
          (satisfies? ProtocolReadExample (ProtocolImmutableExample 0))
          (satisfies? ProtocolReadExample (ProtocolMutableExample 0))])
       (extend-type ProtocolImmutableExample ProtocolReadExample
         (protocol-read-example [receiver] (+ 1 (:value receiver))))
       (def protocol-extension-replaced
         (protocol-read-example (ProtocolImmutableExample 41)))

       (defstruct ProtocolReloadBox [value])
       (defprotocol ProtocolReloadExample
         (protocol-reload-read [receiver]))
       (extend-type ProtocolReloadBox ProtocolReloadExample
         (protocol-reload-read [receiver] (:value receiver)))
       (def protocol-reload-before
         (protocol-reload-read (ProtocolReloadBox 41)))
       (defprotocol ProtocolReloadExample
         (protocol-reload-read [receiver]))
       (def protocol-reload-cleared
         (thrown? (fn [] (protocol-reload-read (ProtocolReloadBox 41)))))
       (extend-type ProtocolReloadBox ProtocolReloadExample
         (protocol-reload-read [receiver] (+ 1 (:value receiver))))
       (def protocol-reload-after
         (protocol-reload-read (ProtocolReloadBox 41)))

       (def protocol-collision-method 7)
       (def protocol-collision-rejected
         (thrown?
           (fn []
             (eval
               '(defprotocol ProtocolCollisionExample
                  (protocol-collision-fresh [receiver])
                  (protocol-collision-method [receiver]))))))
       (def protocol-collision-atomic
         [(thrown? (fn [] (eval 'ProtocolCollisionExample)))
          (thrown? (fn [] (eval 'protocol-collision-fresh)))
          (= 7 protocol-collision-method)])

       [(receiver-case :inheritance/parent-required
          [false true :ready :closed]
          [protocol-inheritance-before
           (nth protocol-inheritance-after 0)
           (nth protocol-inheritance-after 1)
           (nth protocol-inheritance-after 2)])
        (receiver-case :extension/immutable-mutable
          [41 42 true true]
          protocol-extension-initial)
        (receiver-case :extension/replace
          42
          protocol-extension-replaced)
        (receiver-case :reload/same-protocol
          [41 true 42]
          [protocol-reload-before protocol-reload-cleared protocol-reload-after])
        (receiver-case :collision/reject-atomically
          [true true true true]
          [protocol-collision-rejected
           (nth protocol-collision-atomic 0)
           (nth protocol-collision-atomic 1)
           (nth protocol-collision-atomic 2)])
        (receiver-case :error/normalized-categories
          [true true]
          [(try
             (protocol-read-example)
             false
             (catch Throwable error
               (str/includes? (ex-message error) "protocol/arity")))
           (try
             (protocol-read-example ICount)
             false
             (catch Throwable error
               (str/includes? (ex-message error)
                              "protocol/unsupported-receiver")))])])))

;; Capability-specific protocol cases migrated from the original JVM and Rust
;; host assertions. Hosts consume these entrypoints instead of owning guest
;; snippets or expected values.
(extend-type ProtocolUseCase IStreamWrite
  (write [fixture value] [:written value]))

(extend-type ProtocolUseCase IAbort
  (abort [fixture error] [:aborted error]))

(extend-type ProtocolUseCase IStreamPoll
  (poll [fixture] :polled))

(extend-type ProtocolUseCase IStreamOffer
  (offer [fixture value] true))

(extend-type ProtocolUseCase IClosed
  (closed? [fixture] false))

(extend-type ProtocolUseCase IFlush
  (flush [fixture] :flushed))

(extend-type ProtocolUseCase IWork
  (work-spec [fixture] {:op :pure}))

(extend-type ProtocolUseCase IWorkExecutor
  (work-execute [fixture request] [:executed request]))

(extend-type ProtocolUseCase IWorkStore
  (work-query [fixture query] [:query query])
  (work-transact [fixture transition] [:transact transition]))

(extend-type ProtocolUseCase IWorkRef
  (work-id [fixture] "run-1"))

(extend-type ProtocolUseCase IWorkHost
  (work-submit [fixture work input options] [work input options])
  (work-resolve [fixture reference] reference))

(extend-type ProtocolUseCase IWorkRun
  (work-status [fixture] :completed)
  (work-result [fixture] 42)
  (work-events [fixture options] [:events options])
  (work-cancel [fixture reason] [:cancel reason]))

(extend-type ProtocolUseCase IMatch
  (match-value [fixture actual] (= (state-get fixture :value) actual)))

(extend-type ProtocolUseCase IStringLike
  (to-string [fixture] "protocol-use-case")
  (from-string [fixture text] text))

(defn protocol-capability-receiver-results []
  (let [fixture (use-case)]
    [(receiver-case :inheritance/stream-duplex
       [true true true true]
       [(satisfies? IStreamDuplex fixture)
        (satisfies? IStream fixture)
        (satisfies? IStreamWrite fixture)
        (satisfies? IAbort fixture)])
     (receiver-case :inheritance/work-host
       [true true]
       [(satisfies? IWorkHost fixture)
        (satisfies? IComponent fixture)])
     (receiver-case :inheritance/work-run
       [true true true]
       [(satisfies? IWorkRun fixture)
        (satisfies? IWorkRef fixture)
        (satisfies? IClosed fixture)])
     (receiver-case :namespace/unqualified-imatch-resolution
       [true true]
       [(boolean IMatch)
        (IMatch/match-value fixture (state-get fixture :value))])
     (receiver-case :namespace/unqualified-work-resolution
       [true true true true]
       [(boolean IWork)
        (boolean IWorkRef)
        (= {:op :pure} (IWork/work-spec fixture))
        (= "run-1" (IWorkRef/work-id fixture))])
     (receiver-case :native/string-like
       [true "hello/world" :hello/world]
       [(satisfies? IStringLike :hello)
        (IStringLike/to-string :hello/world)
        (IStringLike/from-string :sample "hello/world")])
     (receiver-case :extension/string-like
       ["protocol-use-case" "restored"]
       [(IStringLike/to-string fixture)
        (IStringLike/from-string fixture "restored")])
     (receiver-case :extension/native-protocols
       [true true true true true true true true true]
       [(satisfies? IStreamWrite fixture)
        (satisfies? IStreamPoll fixture)
        (satisfies? IStreamOffer fixture)
        (satisfies? IFlush fixture)
        (satisfies? IWork fixture)
        (satisfies? IWorkExecutor fixture)
        (satisfies? IWorkStore fixture)
        (satisfies? IMatch fixture)
        (satisfies? IStringLike fixture)])]))

(defn capability-protocol-results []
  [(protocol-case :IStreamWrite :write std.protocol.istreamwrite/write
     (= [:written 42] (std.protocol.istreamwrite/write (use-case) 42))
     '(std.protocol.istreamwrite/write unsupported 42))
   (protocol-case :IAbort :abort std.protocol.iabort/abort
     (= [:aborted :failure] (std.protocol.iabort/abort (use-case) :failure))
     '(std.protocol.iabort/abort unsupported :failure))
   (protocol-case :IStreamPoll :poll std.protocol.istreampoll/poll
     (= :polled (std.protocol.istreampoll/poll (use-case)))
     '(std.protocol.istreampoll/poll unsupported))
   (protocol-case :IStreamOffer :offer std.protocol.istreamoffer/offer
     (= true (std.protocol.istreamoffer/offer (use-case) 42))
     '(std.protocol.istreamoffer/offer unsupported 42))
   (protocol-case :IClosed :closed? std.protocol.iclosed/closed?
     (= false (std.protocol.iclosed/closed? (use-case)))
     '(std.protocol.iclosed/closed? unsupported))
   (protocol-case :IFlush :flush std.protocol.iflush/flush
     (= :flushed (std.protocol.iflush/flush (use-case)))
     '(std.protocol.iflush/flush unsupported))
   (protocol-case :IWork :work-spec std.protocol.iwork/work-spec
     (= {:op :pure} (std.protocol.iwork/work-spec (use-case)))
     '(std.protocol.iwork/work-spec unsupported))
   (protocol-case :IWorkExecutor :work-execute std.protocol.iworkexecutor/work-execute
