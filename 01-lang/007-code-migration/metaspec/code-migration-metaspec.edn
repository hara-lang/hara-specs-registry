{:document/id :hara/code-migration-metaspec
 :document/type :hara/metaspec
 :document/version "alpha"
 :document/status :draft
 :document/title "Hara code migration meta-specification"
 :document/summary
 "Defines executable, evidence-backed Clojure and Foundation-to-Hara migration catalogs."

 :spec/conforms-to
 {:spec/id :hara/metaspec-metaspec
  :spec/version "alpha"}
 :spec/artifact-kind :hara/code-migration-spec

 :meta/document-schema
 {:schema/id :hara.code-migration.metaspec/document
  :schema/type :map
  :schema/closed false
  :schema/required
  [:document/id :document/type :document/version :document/status
   :document/title :document/summary :spec/conforms-to
   :migration/authorities :migration/invariants :migration/phases
   :migration/dispositions :migration/rules :migration/targets
   :migration/conformance]}

 :meta/requirements
 [{:requirement/id :migration/evidence
   :requirement/level :must
   :requirement/text
   "Every rule identifies its source authority and the target contract it implements."}
  {:requirement/id :migration/deterministic
   :requirement/level :must
   :requirement/text
   "The same catalog, input bytes, and options produce identical plans, diagnostics, and output bytes."}
  {:requirement/id :migration/source-test-pair
   :requirement/level :must
   :requirement/text
   "A promoted namespace is generated and verified together with its focused test namespace."}
  {:requirement/id :migration/no-manual-fixup
   :requirement/level :must-not
   :requirement/text
   "A promoted generated file contains edits which are not reproducible from the catalog and migrator."}
  {:requirement/id :migration/immutable-input
   :requirement/level :must
   :requirement/text
   "A migration records checksums for its authoritative source and test inputs and does not modify those inputs."}
  {:requirement/id :migration/semantic-recipe
   :requirement/level :may
   :requirement/text
   "A catalog target may select source and test semantic recipes when a structural rewrite cannot express the native design; those recipes remain deterministic migrator inputs."}
  {:requirement/id :migration/frozen-core
   :requirement/level :must
   :requirement/text
   "Migration rules target but do not modify std.foundation, std.native, or std.protocol."}]

 :meta/checkers
 [{:checker/id :hara.code-migration.metaspec.rule/duplicate-id
   :checker/type :builtin
   :checker/op :hara.metaspec.check/unique-field-values
   :checker/requirement :migration/deterministic
   :checker/fields
   [:document/id :requirement/id :rule/id :target/id :case/id]}]}
