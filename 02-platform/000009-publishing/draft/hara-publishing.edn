{:document/id :hara/publishing
 :document/type :hara/tap-protocol
 :document/version "0.1.0"
 :document/status :draft
 :document/title "Hara self-publishing protocol"
 :document/summary
 "Normative signed intake, isolated build, protected finalization and accepted Git record contract."
 :spec/conforms-to {:spec/id :hara/tap-protocol-metaspec
                    :spec/version "0.1.0"}

 :platform/roles
 [{:role/id :hara.publishing.role/publisher
   :role/summary "Signs an immutable package or asset recipe intent."}
  {:role/id :hara.publishing.role/intake
   :role/summary "Validates and schedules untrusted publication requests."}
  {:role/id :hara.publishing.role/builder
   :role/summary "Builds exact source inputs without protected credentials."}
  {:role/id :hara.publishing.role/finalizer
   :role/summary "Revalidates, attests, uploads and proposes accepted records."}
  {:role/id :hara.publishing.role/registry
   :role/summary "Makes accepted records authoritative through protected Git."}]

 :platform/entities
 [{:entity/id :hara.publishing/intent
   :entity/summary "Publisher-signed package or asset build request."
   :entity/fields [:intent/format :intent/kind :intent/tap
                   :intent/coordinate :intent/version :intent/repository-id
                   :intent/tag :intent/commit :intent/recipe-sha256
                   :intent/identity-revision]}
  {:entity/id :hara.publishing/attestation
   :entity/summary "Protected CI statement binding inputs to final objects."
   :entity/fields [:attestation/intent-sha256 :attestation/builder
                   :attestation/outputs :attestation/identity-revision]}
  {:entity/id :hara.publishing/release-record
   :entity/summary "Accepted immutable package or asset release."
   :entity/fields [:release/kind :release/coordinate :release/version
                   :release/intent :release/attestation
                   :release/artifacts]}]

 :platform/operations
 [{:operation/id :hara.publishing.operation/submit
   :operation/role :hara.publishing.role/intake
   :operation/input :hara.publishing/signed-intent
   :operation/output :hara.publishing/request-status
   :operation/failures [:invalid-edn :invalid-signature :unauthorized
                        :stale-identity :duplicate-conflict]}
  {:operation/id :hara.publishing.operation/build
   :operation/role :hara.publishing.role/builder
   :operation/input :hara.publishing/intent
   :operation/output :hara.publishing/build-output
   :operation/failures [:source-mismatch :recipe-mismatch :build-failed
                        :nondeterministic-output]}
  {:operation/id :hara.publishing.operation/finalize
   :operation/role :hara.publishing.role/finalizer
   :operation/input :hara.publishing/build-output
   :operation/output :hara.publishing/release-record
   :operation/failures [:revalidation-failed :object-conflict
                        :registry-conflict]}]

 :platform/invariants
 [{:requirement/id :hara.publishing/hara-signature
   :requirement/level :must
   :requirement/text "The Ed25519 publisher intent is the release authorization; a source tag resolves to the declared commit but needs no second GPG or SSH signature."}
  {:requirement/id :hara.publishing/automatic
   :requirement/level :must
   :requirement/text "An authorized conforming release can complete without per-release human review."}
  {:requirement/id :hara.publishing/credential-separation
   :requirement/level :must
   :requirement/text "Untrusted intake and build jobs cannot access registry mutation, object-store write or CI signing credentials."}
  {:requirement/id :hara.publishing/accepted-git-only
   :requirement/level :must
   :requirement/text "Only accepted intents, signatures, attestations, manifests and release records enter authoritative Git."}
  {:requirement/id :hara.publishing/git-commit-point
   :requirement/level :must
   :requirement/text "A release becomes visible only after its protected registry change is merged."}
  {:requirement/id :hara.publishing/idempotent
   :requirement/level :must
   :requirement/text "Repeating an identical accepted request returns the existing release; the same coordinate and version with different content is rejected."}]

 :platform/conformance
 [{:conformance/id :hara.publishing/intents
   :conformance/path "conformance/intents.edn"}
  {:conformance/id :hara.publishing/finalization
   :conformance/path "conformance/finalization.edn"}]}
