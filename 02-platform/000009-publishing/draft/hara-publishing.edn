{:document/id :hara/publishing
 :document/type :hara/tap-protocol
 :document/version "0.1.0"
 :document/status :draft
 :document/title "Hara self-publishing protocol"
 :document/summary
 "Normative GitHub identity, project.edn intake, isolated package build, protected finalization and accepted Git record contract."
 :spec/conforms-to {:spec/id :hara/tap-protocol-metaspec
                    :spec/version "0.1.0"}

 :platform/roles
 [{:role/id :hara.publishing.role/publisher
   :role/summary "Selects an immutable Git commit whose project.edn declares the release."}
  {:role/id :hara.publishing.role/portal
   :role/summary "Uses GitHub sign-in to verify the contributor and submit a registry change."}
  {:role/id :hara.publishing.role/builder
   :role/summary "Builds the exact project in an untrusted environment without protected credentials."}
  {:role/id :hara.publishing.role/finalizer
   :role/summary "Revalidates, attests, uploads immutable objects and proposes accepted records."}
  {:role/id :hara.publishing.role/registry
   :role/summary "Makes accepted records authoritative through protected Git."}]

 :platform/entities
 [{:entity/id :hara.publishing/intent
   :entity/summary "Publisher-authorized release request bound to project.edn at an exact commit."
   :entity/fields [:intent/format :intent/tap :intent/coordinate
                   :intent/version :intent/repository-id :intent/tag
                   :intent/commit :intent/project-sha256
                   :intent/identity-revision]}
  {:entity/id :hara.publishing/attestation
   :entity/summary "Protected CI statement binding project input, lock and final archive bytes."
   :entity/fields [:attestation/intent-sha256 :attestation/builder
                   :attestation/project-sha256 :attestation/lock-sha256
                   :attestation/outputs :attestation/identity-revision]}
  {:entity/id :hara.publishing/release-record
   :entity/summary "Accepted immutable package release."
   :entity/fields [:release/coordinate :release/version :release/commit
                   :release/project-sha256 :release/archive-sha256
                   :release/attestation]}]

 :platform/operations
 [{:operation/id :hara.publishing.operation/sign-in
   :operation/role :hara.publishing.role/portal
   :operation/input :github/oauth-code
   :operation/output :hara.publishing/session
   :operation/failures [:oauth-denied :identity-unavailable]}
  {:operation/id :hara.publishing.operation/submit
   :operation/role :hara.publishing.role/portal
   :operation/input :hara.publishing/project-selection
   :operation/output :hara.publishing/request-status
   :operation/failures [:invalid-project :unauthorized-repository
                        :tag-mismatch :duplicate-conflict]}
  {:operation/id :hara.publishing.operation/build
   :operation/role :hara.publishing.role/builder
   :operation/input :hara.publishing/intent
   :operation/output :hara.publishing/build-output
   :operation/failures [:source-mismatch :project-mismatch :lock-mismatch
                        :artifact-mismatch :build-failed
                        :nondeterministic-output]}
  {:operation/id :hara.publishing.operation/finalize
   :operation/role :hara.publishing.role/finalizer
   :operation/input :hara.publishing/build-output
   :operation/output :hara.publishing/release-record
   :operation/failures [:revalidation-failed :object-conflict
                        :registry-conflict]}]

 :platform/invariants
 [{:requirement/id :hara.publishing/github-identity
   :requirement/level :must
   :requirement/text "The portal uses GitHub sign-in for contributor identity and a narrowly scoped GitHub App for repository authorization and registry pull requests."}
  {:requirement/id :hara.publishing/project-authority
   :requirement/level :must
   :requirement/text "Publication reads all release, package, build, extension and remote-artifact intent from project.edn at the selected commit."}
  {:requirement/id :hara.publishing/exact-source
   :requirement/level :must
   :requirement/text "The source tag resolves to the declared commit, the repository numeric identifier is recorded, and the exact project.edn digest is signed or portal-attested."}
  {:requirement/id :hara.publishing/credential-separation
   :requirement/level :must
   :requirement/text "Untrusted intake and build jobs cannot access registry mutation, object-store write or finalizer signing credentials."}
  {:requirement/id :hara.publishing/reproducible
   :requirement/level :must
   :requirement/text "The builder resolves project.edn, verifies project.lock.edn, mirrors digest-pinned remote inputs and produces a deterministic .harp."}
  {:requirement/id :hara.publishing/accepted-git-only
   :requirement/level :must
   :requirement/text "Only accepted intents, attestations, generated package indexes and release records enter authoritative registry Git."}
  {:requirement/id :hara.publishing/git-commit-point
   :requirement/level :must
   :requirement/text "A release becomes visible only after its protected registry change is merged."}
  {:requirement/id :hara.publishing/idempotent
   :requirement/level :must
   :requirement/text "Repeating an identical accepted request returns the existing release; the same coordinate and version with different content is rejected."}]

 :platform/conformance
 [{:conformance/id :hara.publishing/intents
   :conformance/path "conformance/intents.edn"}
  {:conformance/id :hara.publishing/finalization
   :conformance/path "conformance/finalization.edn"}]}
