  :case/input
  {:runtime :rust
   :project {:project/source-paths ["src"]
             :project/test-paths ["test"]
             :project/extension-paths []
             :project/dependencies {}}}
  :case/expected
  {:runtime :rust
   :source-paths ["src"]
   :test-paths ["test"]
