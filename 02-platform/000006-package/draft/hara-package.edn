{:document/id :hara/package
 :document/type :hara/tap-protocol
 :document/version "0.2.0"
 :document/status :draft
 :document/title "Hara package protocol"
 :document/summary
 "Normative package coordinates, manifests, resolution, lock, cache, installation and release-record contract."
 :spec/conforms-to {:spec/id :hara/tap-protocol-metaspec
                    :spec/version "0.1.0"}

 :platform/roles
 [{:role/id :hara.package.role/project
   :role/summary "Declares editable dependency and package intent."}
  {:role/id :hara.package.role/resolver
   :role/summary "Resolves SemVer intent into a verified exact graph."}
  {:role/id :hara.package.role/registry
   :role/summary "Publishes accepted immutable package release records."}
  {:role/id :hara.package.role/installer
   :role/summary "Places verified archives in local content-addressed storage."}]

 :platform/entities
 [{:entity/id :hara.package/coordinate
   :entity/summary "Tap-qualified owner and package name."
   :entity/fields [:coordinate/tap :coordinate/owner :coordinate/name]}
  {:entity/id :hara.package/project-manifest
   :entity/summary "Editable project.edn package and dependency intent."
   :entity/fields [:project/id :project/version :project/dependencies
                   :project/repositories :project/package]}
  {:entity/id :hara.package/lockfile
   :entity/summary "Exact verified dependency graph and tap provenance."
   :entity/fields [:lock/format :lock/taps :lock/packages]}
  {:entity/id :hara.package/release
   :entity/summary "Accepted immutable package version."
   :entity/fields [:release/coordinate :release/version :release/source
                   :release/artifact :release/intent :release/attestation]}]

 :platform/operations
 [{:operation/id :hara.package.operation/resolve
   :operation/role :hara.package.role/resolver
   :operation/input :hara.package/project-manifest
   :operation/output :hara.package/lockfile
   :operation/failures [:unsatisfied-range :tap-untrusted :graph-conflict]}
  {:operation/id :hara.package.operation/install
   :operation/role :hara.package.role/installer
   :operation/input :hara.package/release
   :operation/output :hara.package/installed-root
   :operation/failures [:unverified-release :unavailable-object
                        :archive-invalid]}
  {:operation/id :hara.package.operation/yank
   :operation/role :hara.package.role/registry
   :operation/input :hara.package/release
   :operation/output :hara.package/yank-record
   :operation/failures [:unauthorized :unknown-release]}]

 :platform/invariants
 [{:requirement/id :hara.package/coordinate
   :requirement/level :must
   :requirement/text "Coordinates use TAP:owner/name; the built-in official tap is canonically named hara."}
  {:requirement/id :hara.package/official-alias
   :requirement/level :may
   :requirement/text "Clients may accept official as a deprecated local alias but must normalize stored coordinates to the hara tap."}
  {:requirement/id :hara.package/immutable-version
   :requirement/level :must
   :requirement/text "One coordinate and version identifies one release digest forever."}
  {:requirement/id :hara.package/yank-history
   :requirement/level :must
   :requirement/text "Yanking prevents new selection without removing historical records or breaking locked verification."}
  {:requirement/id :hara.package/atomic-graph
   :requirement/level :must
   :requirement/text "A dependency graph becomes visible only after every record, signature, object and archive validates."}
  {:requirement/id :hara.package/local-require
   :requirement/level :must
   :requirement/text "require reads verified mounted roots only and never resolves, downloads or publishes packages."}
  {:requirement/id :hara.package/no-install-execution
   :requirement/level :must-not
   :requirement/text "Checking, resolving, downloading, inspecting, installing or mounting executes package lifecycle code."}]

 :platform/conformance
 [{:conformance/id :hara.package/coordinates
   :conformance/path "conformance/coordinates.edn"}
  {:conformance/id :hara.package/releases
   :conformance/path "conformance/releases.edn"}]}
