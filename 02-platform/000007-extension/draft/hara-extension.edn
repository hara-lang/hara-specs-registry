{:document/id :hara/extension
 :document/type :hara/tap-protocol
 :document/version "0.1.0"
 :document/status :draft
 :document/title "Hara extension package protocol"
 :document/summary
 "Normative extension descriptor, provider, ABI, capability and target compatibility contract."
 :spec/conforms-to {:spec/id :hara/tap-protocol-metaspec
                    :spec/version "0.1.0"}

 :platform/roles
 [{:role/id :hara.extension.role/author
   :role/summary "Declares extension providers and required capabilities."}
  {:role/id :hara.extension.role/validator
   :role/summary "Validates descriptor, artifacts and package containment."}
  {:role/id :hara.extension.role/host
   :role/summary "Activates a verified provider under granted capabilities."}]

 :platform/entities
 [{:entity/id :hara.extension/descriptor
   :entity/summary "Canonical hara.extension.edn provider declaration."
   :entity/fields [:extension/format :extension/namespace
                   :extension/providers :extension/capabilities]}
  {:entity/id :hara.extension/provider
   :entity/summary "Target-specific implementation and ABI binding."
   :entity/fields [:provider/type :provider/target :provider/artifact
                   :provider/abi :provider/exports :provider/host-calls]}
  {:entity/id :hara.extension/handle
   :entity/summary "Opaque host-managed resource boundary."
   :entity/fields [:handle/type :handle/owner :handle/lifetime]}]

 :platform/operations
 [{:operation/id :hara.extension.operation/check
   :operation/role :hara.extension.role/validator
   :operation/input :hara.extension/descriptor
   :operation/output :hara/verification-report
   :operation/failures [:unknown-provider :missing-artifact
                        :abi-mismatch :undeclared-capability]}
  {:operation/id :hara.extension.operation/activate
   :operation/role :hara.extension.role/host
   :operation/input :hara.extension/provider
   :operation/output :hara.extension/active-provider
   :operation/failures [:unverified-package :unsupported-target
                        :capability-denied]}]

 :platform/invariants
 [{:requirement/id :hara.extension/package-specialization
   :requirement/level :must
   :requirement/text "An extension is published and verified as a Hara package specialization, not through an independent registry authority."}
  {:requirement/id :hara.extension/no-declaration-authority
   :requirement/level :must-not
   :requirement/text "A descriptor grants capabilities merely by declaring them."}
  {:requirement/id :hara.extension/closed-provider
   :requirement/level :must
   :requirement/text "Provider types, ABI versions and host-call surfaces are validated against a host-owned registry before startup."}
  {:requirement/id :hara.extension/complete-package
   :requirement/level :must
   :requirement/text "Every descriptor, provider artifact and declared asset is contained in and covered by the verified package manifest."}]

 :platform/conformance
 [{:conformance/id :hara.extension/descriptors
   :conformance/path "conformance/descriptors.edn"}]}
